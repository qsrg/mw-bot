# 复制为 .env 并按环境调整
# 所有含密码/key 的项均为必填，无默认值，未配置时启动报错
# 使用：docker compose -f deploy/docker-compose.yml --env-file .env up -d --build
# backend-api 直接启动时自动加载当前目录 .env（也可 -config <path> 指定），已存在的环境变量优先

# ===== 数据库（必填）=====
# 注意：Go 版 scheme 为 mysql://（非 Python 的 mysql+pymysql://）
# common.parseMySQLURL 仅识别 mysql scheme，解析为 user:pass@tcp(host:port)/db
DATABASE_URL=mysql://ai_qa:your-mysql-password@host.docker.internal:3306/ai_qa

# ===== Redis（必填，MVP 未直接使用，保留配置位）=====
REDIS_URL=redis://:your-redis-password@host.docker.internal:6379/0

# ===== 文件存储 =====
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=data/uploads
# chromem-go 持久化目录（语义保留，指向进程内向量库本地文件）
CHROMA_PERSIST_PATH=data/chroma

# ===== 检索 =====
# 混合检索（dense + BM25 RRF 融合），关闭则纯向量检索
HYBRID_SEARCH=true
# 召回候选 chunk 数
RETRIEVE_LIMIT=5
# 检索相关性阈值（余弦相似度下限）
RETRIEVE_SCORE_THRESHOLD=0.3
# rerank 后注入 prompt 的最终条数
RERANK_TOP_N=5
# 意图检测（LLM 精判，关闭则规则快速通道兜底）
INTENT_DETECTION=false
# 中间件注册表（逗号分隔，用于跨中间件歧义反问与按中间件过滤检索）
MIDDLEWARES=rocketmq,kafka,rabbitmq,pulsar,redis,nacos

# ===== 会话记忆 =====
# 会话短期记忆 token 预算（超限时折叠旧消息进 summary）
HISTORY_TOKEN_BUDGET=100000
# 压缩后保留最近消息的比例
HISTORY_RECENT_RATIO=0.7

# ===== 大模型网关（OpenAI 兼容，必填）=====
LLM_BASE_URL=http://host.docker.internal:9000/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
# Embedding 网关地址与密钥（为空回退到 LLM_BASE_URL/LLM_API_KEY）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== MinIO 对象存储（必填，STORAGE_BACKEND=minio 时使用）=====
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=your-minio-access-key-here
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_BUCKET=ai-qa-documents
MINIO_SECURE=false

# ===== JWT 认证（必填，生产环境务必使用强随机密钥）=====
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120

# ===== 运行环境 =====
# local 时 Embedding 走 Fake Provider（确定性伪向量），便于无网关本地联调
# prod 时走真实模型网关
ENVIRONMENT=local

# ===== 后端 HTTP 监听端口 =====
APP_PORT=8080

# ===== RocketMQ MCP Server =====
# NameServer 地址（未配置或为 localhost:9876 时走 mock 数据）
ROCKETMQ_NAMESRV=localhost:9876
