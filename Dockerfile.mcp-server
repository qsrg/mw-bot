# rocketmq-mcp-server 镜像：Go 多阶段构建（编译 → alpine 运行）
# 与 Python 版 mcp-servers/rocketmq/Dockerfile 对齐：暴露 10914，运行 /app/rocketmq-mcp-server
# 单二进制部署，无 Python 运行时与依赖安装开销

# ---- 阶段 1：编译 ----
FROM golang:1.25-alpine AS builder

# CGO_ENABLED=0：纯 Go 静态编译；GOARCH 跟随构建机架构（M28）
ENV CGO_ENABLED=0 GOOS=linux

WORKDIR /build

# 先复制依赖清单，利用 Docker 层缓存
COPY go.mod go.sum ./
RUN go mod download

# 复制源码并编译 rocketmq-mcp-server 二进制
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN go build -trimpath -ldflags="-s -w" -o /out/rocketmq-mcp-server ./cmd/rocketmq-mcp-server

# ---- 阶段 2：运行 ----
FROM alpine:3.20

# ca-certificates：real 模式调用 RocketMQ Admin API 需要
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /out/rocketmq-mcp-server /app/rocketmq-mcp-server

# 非 root 运行（M29）
RUN adduser -D -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 10914

# 健康检查（L19）
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:10914/health || exit 1

# 运行 MCP Server；ROCKETMQ_NAMESRV 与 APP_PORT 通过环境变量注入
CMD ["/app/rocketmq-mcp-server"]
