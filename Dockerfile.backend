# backend-api 镜像：Go 多阶段构建（编译 → alpine 运行）
# 与 Python 版 backend/Dockerfile 对齐：暴露 8080，运行 /app/backend-api
# 单二进制部署，无 Python 运行时与依赖安装开销

# ---- 阶段 1：编译 ----
FROM golang:1.25-alpine AS builder

# CGO_ENABLED=0：纯 Go 静态编译，chromem-go/gse/minio-go 均无 CGO 依赖
# GOOS=linux：目标平台与运行镜像一致；GOARCH 不指定，跟随构建机架构（M28）
ENV CGO_ENABLED=0 GOOS=linux

WORKDIR /build

# 先复制依赖清单，利用 Docker 层缓存：仅 go.mod/go.sum 变化时才重新拉依赖
COPY go.mod go.sum ./
RUN go mod download

# 复制源码并编译 backend-api 二进制
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN go build -trimpath -ldflags="-s -w" -o /out/backend-api ./cmd/backend-api

# ---- 阶段 2：运行 ----
FROM alpine:3.20

# ca-certificates：HTTPS 调用模型网关与 MinIO 需要
# tzdata：Asia/Shanghai 时区（日志时间戳本地化）
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# 复制编译产物
COPY --from=builder /out/backend-api /app/backend-api

# 数据持久化目录：chromem-go 向量库 + 本地文件上传
# compose 中通过命名卷挂载到 /app/data
RUN mkdir -p /app/data/uploads /app/data/chroma

# 非 root 运行（M29）
RUN adduser -D -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

# 健康检查（L19）：alpine 自带 busybox wget
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

# 运行 backend-api；配置通过环境变量注入（DATABASE_URL/LLM_API_KEY 等）
CMD ["/app/backend-api"]
